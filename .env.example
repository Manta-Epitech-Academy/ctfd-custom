# Copy to .env (gitignored) and fill in to let the admin sync page
# (/admin/workshop/sync) authenticate as a preset admin. See
# workshop_platform/plugins/workshop/syncpage.py and CTFd/utils/security/auth.py.
# Leave unset and the sync page just reports that it's missing credentials.
WS_ADMIN_NAME=admin
WS_ADMIN_EMAIL=admin@ctfd.local
WS_ADMIN_PASSWORD=
WS_ADMIN_TOKEN=
